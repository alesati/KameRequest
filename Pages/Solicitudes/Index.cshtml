@page
@model KameRequest.Pages.Solicitudes.IndexModel
@{
    ViewData["Title"] = "Solicitudes";
}

<div class="container py-4 app-page solicitudes-page">
    <div class="page-header">
        <h1>Solicitudes</h1>
        <div class="page-header-actions">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearSolicitud">Nueva solicitud</button>
        </div>
    </div>
    @if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

    <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Consecutivo</th><th>Título</th><th>Representante</th><th>Estado</th><th>Fecha de ingreso</th><th>Portal externo</th><th>Acciones</th></tr></thead><tbody>
    @foreach (var solicitud in Model.Solicitudes)
    {
        var fechaVencimiento = IndexModel.AgregarDiasHabiles(solicitud.FechaIngreso, 5);
        var claseFila = solicitud.Estado == "Vencida" ? "table-danger" : fechaVencimiento == DateTime.Today ? "table-warning" : solicitud.Estado == "Nueva" ? "table-success" : string.Empty;
        var claseEstado = solicitud.Estado switch
        {
            "Nueva" => "estado-nueva",
            "Iniciada" => "estado-iniciada",
            "Respondida" => "estado-respondida",
            "Vencida" => "estado-vencida",
            _ => "estado-general"
        };
        <tr class="@claseFila"><td>@solicitud.ConsecutivoOficio</td><td>@solicitud.Titulo</td><td>@solicitud.Representante</td><td><span class="estado-solicitud @claseEstado">@solicitud.Estado</span></td><td>@solicitud.FechaIngreso.ToString("dd/MM/yyyy")</td>
            <td>
                @if (solicitud.PublicadaExterna)
                {
                    <span class="estado-solicitud publicacion-activa">Publicada</span>
                    <small class="d-block text-muted">Hasta @solicitud.FechaVencimientoPublicacion?.ToString("dd/MM/yyyy")</small>
                }
                else
                {
                    <span class="estado-solicitud publicacion-inactiva">No publicada</span>
                }
            </td>
            <td class="text-nowrap">
                <div class="dropdown acciones-solicitud">
                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        Acciones
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#modalGestionSolicitud" data-modal-url="@Url.Page("/Solicitudes/Desglose", new { id = solicitud.IdSolicitud, modal = 1 })">Desglose</button></li>
                        <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#modalGestionSolicitud" data-modal-url="@Url.Page("/Solicitudes/Tarea", new { id = solicitud.IdSolicitud, modal = 1 })">Tareas</button></li>
                        <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#modalGestionSolicitud" data-modal-url="@Url.Page("/Solicitudes/Participaciones", new { id = solicitud.IdSolicitud, modal = 1 })">Participaciones</button></li>
                        <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#publicarSolicitud-@solicitud.IdSolicitud">Portal externo</button></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#editarSolicitud-@solicitud.IdSolicitud">Editar</button></li>
                        <li><button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#eliminarSolicitud-@solicitud.IdSolicitud">Eliminar</button></li>
                    </ul>
                </div>
            <div class="modal fade" id="publicarSolicitud-@solicitud.IdSolicitud" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form method="post" asp-page-handler="GuardarPublicacion">
                            <div class="modal-header">
                                <h2 class="modal-title fs-5">Publicación externa</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body">
                                @if (Model.PublicacionConError == solicitud.IdSolicitud && !string.IsNullOrWhiteSpace(Model.ErrorPublicacion))
                                {
                                    <div class="alert alert-danger alerta-publicacion" role="alert">@Model.ErrorPublicacion</div>
                                }
                                <input type="hidden" name="IdSolicitudPublicacion" value="@solicitud.IdSolicitud" />
                                <label class="form-label" for="publicada-@solicitud.IdSolicitud">Disponibilidad en portal externo</label>
                                <select class="form-select mb-3" name="PublicadaExterna" id="publicada-@solicitud.IdSolicitud">
                                    @if (solicitud.PublicadaExterna)
                                    {
                                        <option value="true" selected>Publicar solicitud</option>
                                        <option value="false">No publicar solicitud</option>
                                    }
                                    else
                                    {
                                        <option value="true">Publicar solicitud</option>
                                        <option value="false" selected>No publicar solicitud</option>
                                    }
                                </select>
                                <label class="form-label" for="vencimiento-@solicitud.IdSolicitud">Vencimiento de publicación</label>
                                <input class="form-control" type="date" name="FechaVencimientoPublicacion"
                                       id="vencimiento-@solicitud.IdSolicitud"
                                       value="@solicitud.FechaVencimientoPublicacion?.ToString("yyyy-MM-dd")" />
                                <small class="text-muted">La solicitud deja de mostrarse después de esta fecha.</small>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-primary">Guardar publicación</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-edit" data-bs-toggle="modal" data-bs-target="#editarSolicitud-@solicitud.IdSolicitud">Editar</button>
            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#eliminarSolicitud-@solicitud.IdSolicitud">Eliminar</button>

            <div class="modal fade modal-solicitud-form" id="editarSolicitud-@solicitud.IdSolicitud" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <form method="post" asp-page="/Solicitudes/Editar" asp-route-id="@solicitud.IdSolicitud" class="d-flex flex-column h-100">
                            <div class="modal-header">
                                <h2 class="modal-title fs-5">Editar solicitud</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" name="Solicitud.IdSolicitud" value="@solicitud.IdSolicitud" />
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Consecutivo de oficio</label>
                                        <input class="form-control" name="Solicitud.ConsecutivoOficio" value="@solicitud.ConsecutivoOficio" required />
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label">Título</label>
                                        <input class="form-control" name="Solicitud.Titulo" value="@solicitud.Titulo" required />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Descripción</label>
                                        <textarea class="form-control" name="Solicitud.Descripcion" rows="2">@solicitud.Descripcion</textarea>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Representante</label>
                                        <select class="form-select" name="Solicitud.IdRepresentante">
                                            @foreach (var representante in Model.Representantes)
                                            {
                                                <option value="@representante.IdRepresentante" selected="@(representante.IdRepresentante == solicitud.IdRepresentante)">@representante.Nombre</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Estado</label>
                                        <select class="form-select" name="Solicitud.IdEstado">
                                            @foreach (var estado in Model.Estados)
                                            {
                                                <option value="@estado.IdEstado" selected="@(estado.IdEstado == solicitud.IdEstado)">@estado.Nombre</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Fecha de ingreso</label>
                                        <input type="date" class="form-control" name="Solicitud.FechaIngreso" value="@solicitud.FechaIngreso.ToString("yyyy-MM-dd")" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Fecha de respuesta</label>
                                        <input type="date" class="form-control" name="Solicitud.FechaRespuesta" value="@(solicitud.FechaRespuesta?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Fecha de inicio</label>
                                        <input type="date" class="form-control" name="Solicitud.FechaInicio" value="@(solicitud.FechaInicio?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Documento de respuesta</label>
                                        <input class="form-control" name="Solicitud.DocumentoRespuesta" value="@solicitud.DocumentoRespuesta" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Documento de inicio</label>
                                        <input class="form-control" name="Solicitud.DocumentoInicio" value="@solicitud.DocumentoInicio" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Observaciones</label>
                                        <textarea class="form-control" name="Solicitud.Observaciones" rows="2">@solicitud.Observaciones</textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="modal fade" id="eliminarSolicitud-@solicitud.IdSolicitud" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Eliminar solicitud</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Desea eliminar la solicitud <strong>@solicitud.ConsecutivoOficio</strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="post" asp-page-handler="Eliminar">
                    <input type="hidden" name="idSolicitud" value="@solicitud.IdSolicitud" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>
        </td></tr>
    }
    </tbody></table></div>
    @if (Model.TotalPaginas > 1) { <nav aria-label="Paginacion de solicitudes"><ul class="pagination">@for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++) { <li class="page-item @(pagina == Model.PaginaActual ? "active" : "")"><a class="page-link" asp-route-pagina="@pagina">@pagina</a></li> }</ul></nav> }
</div>

<div class="modal fade modal-solicitud-form" id="modalCrearSolicitud" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page="/Solicitudes/Crear" class="d-flex flex-column h-100">
                <div class="modal-header">
                    <h2 class="modal-title fs-5">Nueva solicitud</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Consecutivo de oficio</label>
                            <input class="form-control" name="Solicitud.ConsecutivoOficio" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Título</label>
                            <input class="form-control" name="Solicitud.Titulo" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" name="Solicitud.Descripcion" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Representante</label>
                            <select class="form-select" name="Solicitud.IdRepresentante" required>
                                <option value="">Seleccione...</option>
                                @foreach (var representante in Model.Representantes)
                                {
                                    <option value="@representante.IdRepresentante">@representante.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fecha de ingreso</label>
                            <input type="date" class="form-control" name="Solicitud.FechaIngreso" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha de respuesta</label>
                            <input type="date" class="form-control" name="Solicitud.FechaRespuesta" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha de inicio</label>
                            <input type="date" class="form-control" name="Solicitud.FechaInicio" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Estado inicial</label>
                            <input class="form-control" value="Nueva" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Documento de respuesta</label>
                            <input class="form-control" name="Solicitud.DocumentoRespuesta" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Documento de inicio</label>
                            <input class="form-control" name="Solicitud.DocumentoInicio" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" name="Solicitud.Observaciones" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar solicitud</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade gestion-modal" id="modalGestionSolicitud" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen-xl-down modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="tituloModalGestion">Gestión de solicitud</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="contenidoModalGestion" title="Gestión de solicitud"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // carga tareas o desgloses dentro de una sola ventana modal
        const modalGestion = document.getElementById('modalGestionSolicitud');
        const contenidoModalGestion = document.getElementById('contenidoModalGestion');
        const tituloModalGestion = document.getElementById('tituloModalGestion');

        modalGestion?.addEventListener('show.bs.modal', evento => {
            const boton = evento.relatedTarget;
            const url = boton?.getAttribute('data-modal-url');
            tituloModalGestion.textContent = boton?.textContent?.trim() || 'Gestión de solicitud';
            contenidoModalGestion.src = url || 'about:blank';
        });

        modalGestion?.addEventListener('hidden.bs.modal', () => {
            contenidoModalGestion.src = 'about:blank';
        });

        @if (Model.PublicacionConError.HasValue)
        {
            <text>
            document.addEventListener('DOMContentLoaded', () => {
                const modalPortal = document.getElementById('publicarSolicitud-@Model.PublicacionConError');
                if (modalPortal) {
                    bootstrap.Modal.getOrCreateInstance(modalPortal).show();
                }
            });
            </text>
        }
    </script>
}
