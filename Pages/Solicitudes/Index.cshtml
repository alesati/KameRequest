@page
@model KameRequest.Pages.Solicitudes.IndexModel
@{
    ViewData["Title"] = "Solicitudes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Solicitudes</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Consecutivo</th>
                            <th>Título</th>
                            <th>Representante</th>
                            <th>Estado</th>
                            <th>Fecha Ingreso</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ListaSolicitudes != null && Model.ListaSolicitudes.Any())
                        {
                            @foreach (var item in Model.ListaSolicitudes)
                            {
                                <tr>
                                    <td>@item.Consecutivo</td>
                                    <td>@item.Titulo</td>
                                    <td>@item.Representante</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.Estado</span>
                                    </td>
                                    <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <!-- Enlace directo a la nueva página independiente de Desglose (HU SOL2) -->
                                        <a asp-page="/Solicitudes/Desglose" asp-route-id="@item.IdSolicitud" class="btn btn-sm btn-info text-white me-1">
                                            Desglose
                                        </a>

                                        <!-- Enlace directo a la nueva página independiente de Tareas (HU TAR1) -->
                                        <a asp-page="/Solicitudes/Tarea" asp-route-id="@item.IdSolicitud" class="btn btn-sm btn-warning text-dark">
                                            Tarea
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-3">No hay solicitudes registradas en la base de datos.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Reutilizable únicamente para Tareas -->
<div class="modal fade" id="modalTarea" tabindex="-1" aria-labelledby="modalTareaLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalTareaLabel">Módulo de Tareas</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <!-- ENCABEZADO CON INFORMACIÓN DE LA SOLICITUD -->
                <div class="card bg-light mb-3">
                    <div class="card-body">
                        <small class="text-muted fw-bold" id="modalOficio">Oficio: -</small>
                        <h4 class="card-title text-primary mt-1" id="modalTitulo">Título</h4>
                        <p class="card-text" id="modalDescripcion">Descripción...</p>
                        <hr />
                        <div class="row text-center text-md-start">
                            <div class="col-md-4"><strong>Fecha Ingreso:</strong> <span id="modalFIngreso">-</span></div>
                            <div class="col-md-4"><strong>Fecha Respuesta:</strong> <span id="modalFRespuesta">-</span></div>
                            <div class="col-md-4"><strong>Fecha Inicio:</strong> <span id="modalFInicio">-</span></div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5>Lista de Tareas</h5>
                </div>

                <div id="modalContenido" class="border rounded p-3 bg-white">
                    <p class="text-muted text-center my-3">Sección de tareas pendiente de implementar.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalTarea(idSolicitud, oficio, titulo, descripcion, fIngreso, fRespuesta, fInicio) {
            // Llenar datos del encabezado en el modal de Tareas
            document.getElementById('modalOficio').innerText = 'Oficio: ' + oficio;
            document.getElementById('modalTitulo').innerText = titulo;
            document.getElementById('modalDescripcion').innerText = descripcion;
            document.getElementById('modalFIngreso').innerText = fIngreso;
            document.getElementById('modalFRespuesta').innerText = fRespuesta;
            document.getElementById('modalFInicio').innerText = fInicio;

            document.getElementById('modalTareaLabel').innerText = 'Módulo de Tareas - Solicitud #' + idSolicitud;

            // Mostrar el modal de Tarea
            var modalElement = document.getElementById('modalTarea');
            var bootstrapModal = new bootstrap.Modal(modalElement);
            bootstrapModal.show();
        }
    </script>
}