@page
@model KameRequest.Pages.Solicitudes.ParticipacionesModel
@{
    ViewData["Title"] = "Participaciones";
}

<div class="container py-4 app-page">
    <a class="btn btn-outline-secondary mb-3" asp-page="/Solicitudes/Index">← Volver a Solicitudes</a>

    <div class="page-header">
        <div>
            <h1>Participaciones recibidas</h1>
            <p class="mb-0 text-muted">@Model.Solicitud?.ConsecutivoOficio - @Model.Solicitud?.Titulo</p>
        </div>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (Model.ParticipacionSeleccionada is not null)
    {
        var participacion = Model.ParticipacionSeleccionada;
        var estadoParticipacion = string.IsNullOrWhiteSpace(participacion.Estado) ? "Pendiente" : participacion.Estado;
        var claseEstadoParticipacion = estadoParticipacion == "Aprobada" ? "publicacion-activa" : "estado-general";
        <a class="btn btn-outline-secondary mb-3" asp-route-id="@Model.Solicitud?.IdSolicitud">← Regresar a participaciones</a>
        <section class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Propuesta de @participacion.NombreProveedor</strong>
                <span class="estado-solicitud @claseEstadoParticipacion">@estadoParticipacion</span>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Cédula:</strong> @participacion.CedulaJuridica</div>
                    <div class="col-md-4"><strong>Representante:</strong> @participacion.NombreRepresentante</div>
                    <div class="col-md-4"><strong>Correo:</strong> @participacion.Correo</div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Periodo</th><th>Horas</th><th>Monto</th><th>IVA</th><th>Total</th><th>% cobro</th><th>Observaciones</th></tr></thead>
                        <tbody>
                            @foreach (var desglose in participacion.Desgloses)
                            {
                                <tr>
                                    <td>@desglose.Mes / @desglose.Anio</td>
                                    <td>@desglose.Horas</td>
                                    <td>@desglose.Monto.ToString("C")</td>
                                    <td>@desglose.Iva.ToString("C")</td>
                                    <td>@desglose.Total.ToString("C")</td>
                                    <td>@desglose.PorcentajeCobro%</td>
                                    <td>@desglose.Observaciones</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <form method="post" asp-page-handler="Aprobar">
                    <input type="hidden" name="idSolicitud" value="@Model.Solicitud?.IdSolicitud" />
                    <input type="hidden" name="idParticipacion" value="@participacion.IdParticipacion" />
                    @if (Model.TienePropuestaAprobada)
                    {
                        <button class="btn btn-primary" type="submit" disabled>Aprobar propuesta</button>
                        <small class="d-block text-muted mt-2">Ya existe una propuesta aprobada para esta solicitud.</small>
                    }
                    else
                    {
                        <button class="btn btn-primary" type="submit">Aprobar propuesta</button>
                    }
                </form>
            </div>
        </section>
    }
    else if (!Model.Lista.Any())
    {
        <div class="alert alert-info">Aún no existen participaciones para esta solicitud.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Cédula jurídica</th><th>Proveedor</th><th>Fecha</th><th>Estado</th></tr></thead>
                <tbody>
                    @foreach (var participacion in Model.Lista)
                    {
                        var estadoParticipacion = string.IsNullOrWhiteSpace(participacion.Estado) ? "Pendiente" : participacion.Estado;
                        var claseEstadoParticipacion = estadoParticipacion == "Aprobada" ? "publicacion-activa" : "estado-general";
                        <tr>
                            <td><a asp-route-id="@Model.Solicitud?.IdSolicitud" asp-route-participacion="@participacion.IdParticipacion">@participacion.CedulaJuridica</a></td>
                            <td>@participacion.NombreProveedor</td>
                            <td>@participacion.FechaParticipacion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="estado-solicitud @claseEstadoParticipacion">@estadoParticipacion</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
