@page "{id:int?}"
@model KameRequest.Pages.Solicitudes.TareasModel
@{
    ViewData["Title"] = "Gestión de Tareas";
    Layout = HttpContext.Request.Query.ContainsKey("modal") ? "_ModalLayout" : "_Layout";
}

<div class="container-fluid mt-4 px-4 solicitudes-page gestion-listado">
    <a asp-page="/Solicitudes/Index" class="btn btn-outline-secondary mb-3 volver-solicitudes">
        ← Volver a Solicitudes
    </a>

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @Model.MensajeError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ENCABEZADO SOLICITUD -->
    @if (Model.SolicitudActual != null)
    {
        <div class="card bg-light mb-4 shadow-sm">
            <div class="card-body">
                <small class="text-muted fw-bold">Oficio: @Model.SolicitudActual.Consecutivo</small>
                <h3 class="card-title text-primary mt-1">@Model.SolicitudActual.Titulo</h3>
                <p class="card-text">@Model.SolicitudActual.Descripcion</p>
                <hr />
                <div class="row text-center text-md-start">
                    <div class="col-md-3"><strong>Representante:</strong> @Model.SolicitudActual.Representante</div>
                    <div class="col-md-3"><strong>Fecha Ingreso:</strong> @Model.SolicitudActual.FechaIngreso.ToString("dd/MM/yyyy")</div>
                    <div class="col-md-3"><strong>Fecha Respuesta:</strong> @(Model.SolicitudActual.FechaRespuesta.HasValue ? Model.SolicitudActual.FechaRespuesta.Value.ToString("dd/MM/yyyy") : "N/A")</div>
                    <div class="col-md-3"><strong>Fecha Inicio:</strong> @(Model.SolicitudActual.FechaInicio.HasValue ? Model.SolicitudActual.FechaInicio.Value.ToString("dd/MM/yyyy") : "N/A")</div>
                </div>
            </div>
        </div>
    }

    <!-- TABLA DE TAREAS -->
    <div class="card shadow-sm gestion-tabla">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Tareas Asociadas</h5>
            <button type="button" class="btn btn-success btn-sm" onclick="mostrarFormulario('modalNuevaTarea')">
                Nueva tarea
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle text-center">
                    <thead class="table-secondary">
                        <tr>
                            <th>Fecha</th>
                            <th class="text-start">Descripción</th>
                            <th>Usuario</th>
                            <th>Horas Invertidas</th>
                            <th style="width: 140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ListaTareas.Any())
                        {
                            @foreach (var item in Model.ListaTareas)
                            {
                                <tr>
                                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td class="text-start">@item.Descripcion</td>
                                    <td><span class="badge bg-info text-dark">@item.Usuario</span></td>
                                    <td class="fw-bold">@item.HorasInvertidas.ToString("N2")</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            @* El usuario de una tarea se conserva, solo se editan los datos de ejecucion *@
                                            <button type="button" class="btn btn-sm btn-edit"
                                                    onclick="abrirModalEditar(@item.IdTarea, '@item.Descripcion.Replace("'", "\\'").Replace("\r\n", " ")', '@item.Fecha.ToString("yyyy-MM-dd")', @item.HorasInvertidas.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                                Editar
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmarEliminarTarea(@item.IdTarea)">Eliminar</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-3 text-muted">No hay tareas registradas para esta solicitud.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPaginas > 1)
            {
                <nav aria-label="Paginacion de tareas">
                    <ul class="pagination justify-content-center mb-0">
                        @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                        {
                            <li class="page-item @(pagina == Model.PaginaActual ? "active" : "")">
                                <a class="page-link" asp-route-id="@Model.SolicitudActual?.IdSolicitud" asp-route-pagina="@pagina" asp-route-modal="@(HttpContext.Request.Query.ContainsKey("modal") ? "1" : null)">@pagina</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
<!-- FORMULARIO PARA AGREGAR TAREA -->
<div class="gestion-formulario d-none" id="modalNuevaTarea" tabindex="-1" aria-hidden="true">
    <div class="gestion-formulario-dialog">
        <div class="gestion-formulario-content">
            <form method="post" asp-page-handler="Agregar">
                <input type="hidden" name="modal" value="@(HttpContext.Request.Query.ContainsKey("modal") ? "true" : "false")" />
                <input type="hidden" name="idSolicitud" value="@Model.SolicitudActual?.IdSolicitud" />
                <div class="gestion-formulario-header bg-success text-white">
                    <h5 class="modal-title">Nueva tarea</h5>
                    <button type="button" class="btn-close btn-close-white" onclick="cerrarFormulario()"></button>
                </div>
                <div class="gestion-formulario-body">
                    <div class="mb-3">
                        <label class="form-label">Descripción de la Tarea</label>
                        <textarea asp-for="NuevaTarea.Descripcion" class="form-control" rows="3" required placeholder="Escriba el detalle del trabajo realizado..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fecha</label>
                            <input type="date" asp-for="NuevaTarea.Fecha" class="form-control" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Usuario</label>
                            <input type="text" class="form-control" value="@(User.Identity?.Name ?? "Usuario")" readonly />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Horas Invertidas</label>
                            <input type="number" step="0.01" asp-for="NuevaTarea.HorasInvertidas" class="form-control" required placeholder="0.00" />
                        </div>
                    </div>
                </div>
                <div class="gestion-formulario-footer">
                    <button type="button" class="btn btn-secondary" onclick="cerrarFormulario()">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Tarea</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- FORMULARIO PARA EDITAR TAREA -->
<div class="gestion-formulario d-none" id="modalEditarTarea" tabindex="-1" aria-hidden="true">
    <div class="gestion-formulario-dialog">
        <div class="gestion-formulario-content">
            <form method="post" asp-page-handler="Editar">
                <input type="hidden" name="modal" value="@(HttpContext.Request.Query.ContainsKey("modal") ? "true" : "false")" />
                <input type="hidden" name="idSolicitud" value="@Model.SolicitudActual?.IdSolicitud" />
                <input type="hidden" id="editIdTarea" asp-for="TareaEditar.IdTarea" />

                <div class="gestion-formulario-header bg-primary text-white">
                    <h5 class="modal-title">Editar tarea</h5>
                    <button type="button" class="btn-close btn-close-white" onclick="cerrarFormulario()"></button>
                </div>
                <div class="gestion-formulario-body">
                    <div class="mb-3">
                        <label class="form-label">Descripción de la Tarea</label>
                        <textarea id="editDescripcion" asp-for="TareaEditar.Descripcion" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fecha</label>
                            <input type="date" id="editFecha" asp-for="TareaEditar.Fecha" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Usuario</label>
                            <input type="text" class="form-control" value="Usuario asignado al crear la tarea" readonly />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Horas Invertidas</label>
                            <input type="number" step="0.01" id="editHorasInvertidas" asp-for="TareaEditar.HorasInvertidas" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="gestion-formulario-footer">
                    <button type="button" class="btn btn-secondary" onclick="cerrarFormulario()">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CONFIRMACION PARA ELIMINAR TAREA -->
<div class="gestion-formulario d-none" id="modalEliminarTarea" tabindex="-1" aria-hidden="true">
    <div class="gestion-formulario-dialog"><div class="gestion-formulario-content"><div class="gestion-formulario-header"><h5 class="modal-title">Eliminar tarea</h5><button type="button" class="btn-close" onclick="cerrarFormulario()"></button></div>
    <div class="gestion-formulario-body">¿Realmente desea eliminar el elemento seleccionado?</div>
    <div class="gestion-formulario-footer"><button type="button" class="btn btn-secondary" onclick="cerrarFormulario()">Cancelar</button><form method="post" asp-page-handler="Eliminar">
        <input type="hidden" name="modal" value="@(HttpContext.Request.Query.ContainsKey("modal") ? "true" : "false")" /><input type="hidden" id="eliminarIdTarea" name="idTarea" /><input type="hidden" name="idSolicitud" value="@Model.SolicitudActual?.IdSolicitud" /><button class="btn btn-danger">Eliminar</button></form></div></div></div>
</div>
</div>
@section Scripts {
    <script>
        // muestra el formulario dentro del mismo espacio donde estaba la tabla
        function mostrarFormulario(id) {
            document.querySelectorAll(".gestion-formulario").forEach(formulario => formulario.classList.add("d-none"));
            document.getElementById(id)?.classList.remove("d-none");
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        // al cancelar se oculta el formulario y vuelve a mostrarse el listado
        function cerrarFormulario() {
            document.querySelectorAll(".gestion-formulario").forEach(formulario => formulario.classList.add("d-none"));
        }

        function confirmarEliminarTarea(idTarea) {
            document.getElementById("eliminarIdTarea").value = idTarea;
            mostrarFormulario("modalEliminarTarea");
        }

        function abrirModalEditar(idTarea, descripcion, fecha, horas) {
            document.getElementById('editIdTarea').value = idTarea;
            document.getElementById('editDescripcion').value = descripcion;
            document.getElementById('editFecha').value = fecha;
            document.getElementById('editHorasInvertidas').value = horas;
            mostrarFormulario("modalEditarTarea");
        }
    </script>
}