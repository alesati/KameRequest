@page "{id:int?}"
@model KameRequest.Pages.Solicitudes.DesgloseModel
@{
    ViewData["Title"] = "Gestión de Desgloses";
    Layout = HttpContext.Request.Query.ContainsKey("modal") ? "_ModalLayout" : "_Layout";
}

<div class="container-fluid mt-4 px-4 solicitudes-page gestion-listado">
    <a asp-page="/Solicitudes/Index" class="btn btn-outline-secondary mb-3 volver-solicitudes">
        ← Volver a Solicitudes
    </a>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @Model.MensajeError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    <!-- ENCABEZADO SOLICITUD -->
    @if (Model.SolicitudActual != null)
    {
        <div class="card bg-light mb-4 shadow-sm">
            <div class="card-body">
                <small class="text-muted fw-bold">Oficio: @Model.SolicitudActual.Consecutivo</small>
                <h3 class="card-title text-primary mt-1">@Model.SolicitudActual.Titulo</h3>
                <p class="card-text">@Model.SolicitudActual.Descripcion</p>
                <hr />
                <div class="row text-center text-md-start">
                    <div class="col-md-3"><strong>Representante:</strong> @Model.SolicitudActual.Representante</div>
                    <div class="col-md-3"><strong>Fecha Ingreso:</strong> @Model.SolicitudActual.FechaIngreso.ToString("dd/MM/yyyy")</div>
                    <div class="col-md-3"><strong>Fecha Respuesta:</strong> @(Model.SolicitudActual.FechaRespuesta.HasValue ? Model.SolicitudActual.FechaRespuesta.Value.ToString("dd/MM/yyyy") : "N/A")</div>
                    <div class="col-md-3"><strong>Fecha Inicio:</strong> @(Model.SolicitudActual.FechaInicio.HasValue ? Model.SolicitudActual.FechaInicio.Value.ToString("dd/MM/yyyy") : "N/A")</div>
                </div>
            </div>
        </div>
    }

    <!-- TABLA DE DESGLOSES -->
    <div class="card shadow-sm gestion-tabla">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Desglose de la Solicitud</h5>
            <button type="button" class="btn btn-success btn-sm" onclick="mostrarFormulario('modalNuevoDesglose')">
                Nuevo desglose
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle text-center">
                    <thead class="table-secondary">
                        <tr>
                            <th>Mes/Año</th>
                            <th>Horas</th>
                            <th>Monto (₡)</th>
                            <th>IVA (13%)</th>
                            <th>Total (₡)</th>
                            <th>% Cobro</th>
                            <th>Observaciones</th>
                            <th style="width: 140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ListaDesgloses.Any())
                        {
                            @foreach (var item in Model.ListaDesgloses)
                            {
                                <tr>
                                    <td>@item.Mes / @item.Anio</td>
                                    <td>@item.Horas</td>
                                    <td class="text-end">@item.Monto.ToString("N2")</td>
                                    <td class="text-end">@item.Iva.ToString("N2")</td>
                                    <td class="text-end fw-bold">@item.Total.ToString("N2")</td>
                                    <td>@item.PorcentajeCobro%</td>
                                    <td class="text-start">@(string.IsNullOrEmpty(item.Observaciones) ? "-" : item.Observaciones)</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- Botón Editar -->
                                            <button type="button" class="btn btn-sm btn-edit"
                                                    onclick="abrirModalEditar(@item.IdDesglose, @item.Mes, @item.Anio, @item.Horas.ToString(System.Globalization.CultureInfo.InvariantCulture), @item.Monto.ToString(System.Globalization.CultureInfo.InvariantCulture), @item.PorcentajeCobro.ToString(System.Globalization.CultureInfo.InvariantCulture), '@Html.Raw(item.Observaciones ?? "")')">
                                                Editar
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmarEliminarDesglose(@item.IdDesglose)">Eliminar</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-3 text-muted">No hay desgloses registrados para esta solicitud.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPaginas > 1)
            {
                <nav aria-label="Paginacion de desgloses">
                    <ul class="pagination justify-content-center mb-0">
                        @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                        {
                            <li class="page-item @(pagina == Model.PaginaActual ? "active" : "")">
                                <a class="page-link" asp-route-id="@Model.SolicitudActual?.IdSolicitud" asp-route-pagina="@pagina" asp-route-modal="@(HttpContext.Request.Query.ContainsKey("modal") ? "1" : null)">@pagina</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
<!-- FORMULARIO PARA AGREGAR DESGLOSE -->
<div class="gestion-formulario d-none" id="modalNuevoDesglose" tabindex="-1" aria-hidden="true">
    <div class="gestion-formulario-dialog">
        <div class="gestion-formulario-content">
            <form method="post" asp-page-handler="Agregar">
                <input type="hidden" name="modal" value="@(HttpContext.Request.Query.ContainsKey("modal") ? "true" : "false")" />
                <input type="hidden" name="idSolicitud" value="@Model.SolicitudActual?.IdSolicitud" />
                <div class="gestion-formulario-header bg-success text-white">
                    <h5 class="modal-title">Nuevo desglose</h5>
                    <button type="button" class="btn-close btn-close-white" onclick="cerrarFormulario()"></button>
                </div>
                <div class="gestion-formulario-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Mes (1-12)</label>
                            <input type="number" min="1" max="12" asp-for="NuevoDesglose.Mes" class="form-control" required value="@DateTime.Now.Month" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Año</label>
                            <input type="number" min="2000" max="2100" asp-for="NuevoDesglose.Anio" class="form-control" required value="@DateTime.Now.Year" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Horas</label>
                            <input type="number" step="0.01" asp-for="NuevoDesglose.Horas" class="form-control" required placeholder="0.00" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Monto (Sin IVA)</label>
                            <input type="number" step="0.01" id="inputMonto" asp-for="NuevoDesglose.Monto" class="form-control" required placeholder="0.00" oninput="calcularIvaTotal()" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">% Cobro</label>
                            <input type="number" step="0.01" asp-for="NuevoDesglose.PorcentajeCobro" class="form-control" required value="100" />
                        </div>
                    </div>

                    <div class="row bg-light p-2 rounded mb-3 text-center">
                        <div class="col-md-6">
                            <small class="text-muted">IVA (13%):</small>
                            <h6 id="previewIva" class="text-primary mb-0">₡0.00</h6>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Total (Monto + IVA):</small>
                            <h6 id="previewTotal" class="text-success mb-0">₡0.00</h6>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Observaciones</label>
                        <textarea asp-for="NuevoDesglose.Observaciones" class="form-control" rows="2" placeholder="Opcional..."></textarea>
                    </div>
                </div>
                <div class="gestion-formulario-footer">
                    <button type="button" class="btn btn-secondary" onclick="cerrarFormulario()">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- FORMULARIO PARA EDITAR DESGLOSE -->
<div class="gestion-formulario d-none" id="modalEditarDesglose" tabindex="-1" aria-hidden="true">
    <div class="gestion-formulario-dialog">
        <div class="gestion-formulario-content">
            <form method="post" asp-page-handler="Editar">
                <input type="hidden" name="modal" value="@(HttpContext.Request.Query.ContainsKey("modal") ? "true" : "false")" />
                <input type="hidden" name="idSolicitud" value="@Model.SolicitudActual?.IdSolicitud" />
                <input type="hidden" id="editIdDesglose" asp-for="DesgloseEditar.IdDesglose" />

                <div class="gestion-formulario-header bg-primary text-white">
                    <h5 class="modal-title">Editar desglose</h5>
                    <button type="button" class="btn-close btn-close-white" onclick="cerrarFormulario()"></button>
                </div>
                <div class="gestion-formulario-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Mes (1-12)</label>
                            <input type="number" min="1" max="12" id="editMes" asp-for="DesgloseEditar.Mes" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Año</label>
                            <input type="number" min="2000" max="2100" id="editAnio" asp-for="DesgloseEditar.Anio" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Horas</label>
                            <input type="number" step="0.01" id="editHoras" asp-for="DesgloseEditar.Horas" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Monto (Sin IVA)</label>
                            <input type="number" step="0.01" id="editMonto" asp-for="DesgloseEditar.Monto" class="form-control" required oninput="calcularIvaTotalEdit()" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">% Cobro</label>
                            <input type="number" step="0.01" id="editPorcentajeCobro" asp-for="DesgloseEditar.PorcentajeCobro" class="form-control" required />
                        </div>
                    </div>

                    <div class="row bg-light p-2 rounded mb-3 text-center">
                        <div class="col-md-6">
                            <small class="text-muted">IVA (13%):</small>
                            <h6 id="editPreviewIva" class="text-primary mb-0">₡0.00</h6>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Total (Monto + IVA):</small>
                            <h6 id="editPreviewTotal" class="text-success mb-0">₡0.00</h6>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Observaciones</label>
                        <textarea id="editObservaciones" asp-for="DesgloseEditar.Observaciones" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="gestion-formulario-footer">
                    <button type="button" class="btn btn-secondary" onclick="cerrarFormulario()">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CONFIRMACION PARA ELIMINAR DESGLOSE -->
<div class="gestion-formulario d-none" id="modalEliminarDesglose" tabindex="-1" aria-hidden="true">
    <div class="gestion-formulario-dialog"><div class="gestion-formulario-content"><div class="gestion-formulario-header"><h5 class="modal-title">Eliminar desglose</h5><button type="button" class="btn-close" onclick="cerrarFormulario()"></button></div>
    <div class="gestion-formulario-body">¿Realmente desea eliminar el elemento seleccionado?</div>
    <div class="gestion-formulario-footer"><button type="button" class="btn btn-secondary" onclick="cerrarFormulario()">Cancelar</button><form method="post" asp-page-handler="Eliminar">
        <input type="hidden" name="modal" value="@(HttpContext.Request.Query.ContainsKey("modal") ? "true" : "false")" /><input type="hidden" id="eliminarIdDesglose" name="idDesglose" /><input type="hidden" name="idSolicitud" value="@Model.SolicitudActual?.IdSolicitud" /><button class="btn btn-danger">Eliminar</button></form></div></div></div>
</div>
</div>
@section Scripts {
    <script>
        // muestra el formulario dentro del mismo espacio donde estaba la tabla
        function mostrarFormulario(id) {
            document.querySelectorAll(".gestion-formulario").forEach(formulario => formulario.classList.add("d-none"));
            document.getElementById(id)?.classList.remove("d-none");
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        // al cancelar se oculta el formulario y vuelve a mostrarse el listado
        function cerrarFormulario() {
            document.querySelectorAll(".gestion-formulario").forEach(formulario => formulario.classList.add("d-none"));
        }

        function confirmarEliminarDesglose(idDesglose) {
            document.getElementById("eliminarIdDesglose").value = idDesglose;
            mostrarFormulario("modalEliminarDesglose");
        }

        function calcularIvaTotal() {
            const monto = parseFloat(document.getElementById('inputMonto').value) || 0;
            const iva = monto * 0.13;
            const total = monto + iva;
            document.getElementById('previewIva').innerText = '₡' + iva.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('previewTotal').innerText = '₡' + total.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function calcularIvaTotalEdit() {
            const monto = parseFloat(document.getElementById('editMonto').value) || 0;
            const iva = monto * 0.13;
            const total = monto + iva;
            document.getElementById('editPreviewIva').innerText = '₡' + iva.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('editPreviewTotal').innerText = '₡' + total.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function abrirModalEditar(idDesglose, mes, anio, horas, monto, porcentajeCobro, observaciones) {
            document.getElementById('editIdDesglose').value = idDesglose;
            document.getElementById('editMes').value = mes;
            document.getElementById('editAnio').value = anio;
            document.getElementById('editHoras').value = horas;
            document.getElementById('editMonto').value = monto;
            document.getElementById('editPorcentajeCobro').value = porcentajeCobro;
            document.getElementById('editObservaciones').value = observaciones;
            calcularIvaTotalEdit();
            mostrarFormulario("modalEditarDesglose");
        }
    </script>
}