@page
@model KameRequest.Pages.Bitacora.IndexModel
@{ ViewData["Title"] = "Bitácora general"; }

<div class="container py-4">
    <h1>Bitácora general</h1>
    <p class="text-muted">Últimas acciones realizadas por los usuarios.</p>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th></tr></thead>
            <tbody>
                @if (Model.Registros.Count == 0) { <tr><td colspan="3" class="text-muted">No hay acciones registradas.</td></tr> }
                @foreach (var registro in Model.Registros)
                {
                    <tr><td>@registro.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@registro.Usuario</td><td>@registro.Descripcion</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        var inicio = Math.Max(1, Model.Pagina - 2);
        var final = Math.Min(Model.TotalPaginas, Model.Pagina + 2);

        <nav aria-label="Paginación de la bitácora">
            <ul class="pagination flex-wrap">
                <li class="page-item @(Model.Pagina == 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
                </li>

                @if (inicio > 1)
                {
                    <li class="page-item"><a class="page-link" asp-route-pagina="1">1</a></li>
                    @if (inicio > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }

                @for (var pagina = inicio; pagina <= final; pagina++)
                {
                    <li class="page-item @(pagina == Model.Pagina ? "active" : "")">
                        <a class="page-link" asp-route-pagina="@pagina">@pagina</a>
                    </li>
                }

                @if (final < Model.TotalPaginas)
                {
                    @if (final < Model.TotalPaginas - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item"><a class="page-link" asp-route-pagina="@Model.TotalPaginas">@Model.TotalPaginas</a></li>
                }

                <li class="page-item @(Model.Pagina == Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>
