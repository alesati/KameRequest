@page
@model KameRequest.Pages.Cuenta.IniciarSesionModel
@{
    ViewData["Title"] = "Iniciar sesion";
}

<div class="login-page">
    <div class="login-card">
        <img src="~/img/logo-kamerequest.png" alt="Logo de KameRequest" class="login-logo" />
        <h1>Iniciar sesion</h1>
        <p class="text-muted">Ingrese sus datos para utilizar KameRequest.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Datos.NombreUsuario" class="form-label">Usuario</label>
                <input asp-for="Datos.NombreUsuario" class="form-control" autocomplete="username" />
                <span asp-validation-for="Datos.NombreUsuario" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Datos.Contrasena" class="form-label">Contraseña</label>
                <input asp-for="Datos.Contrasena" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Datos.Contrasena" class="text-danger"></span>
            </div>
            <button class="btn btn-primary w-100">Aceptar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
