@page
@model KameRequest.Pages.Mantenimientos.IndexModel
@{
    ViewData["Title"] = "Mantenimientos";
}

<div class="container py-4">
    <h1>Mantenimientos</h1>
    <p>Seleccione el catálogo que desea administrar.</p>

    <div class="list-group maintenance-list">
        <a asp-page="/Usuarios/Index" class="list-group-item list-group-item-action">
            <strong>Usuarios</strong>
            <span>Administrar cuentas y estado de acceso.</span>
        </a>
    </div>

    <a asp-page="/Index" class="btn btn-outline-secondary mt-3">Regresar</a>
</div>
