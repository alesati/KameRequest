<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KameRequest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="estructura-sistema">
            <aside class="menu-lateral">
                <a class="marca-sistema" asp-page="/Index">
                    <span class="icono-sistema" aria-hidden="true">✓</span>
                    <span>KameRequest</span>
                </a>

                <nav class="opciones-menu">
                    <a asp-page="/Index">Inicio</a>
                </nav>

                <form method="post" asp-page="/Cuenta/CerrarSesion" class="mt-auto">
                    <button type="submit" class="boton-salir">Cerrar sesion</button>
                </form>
            </aside>

            <div class="contenido-sistema">
                <header class="encabezado-sistema">
                    <div class="datos-usuario">
                        <span>@User.Identity.Name</span>
                        <span class="avatar-usuario" aria-label="Avatar de usuario">👤</span>
                    </div>
                </header>

                <main role="main" class="contenido-principal">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main role="main" class="contenedor-acceso">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
