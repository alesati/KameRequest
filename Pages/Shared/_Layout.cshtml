@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - KameRequest</title>
    <link rel="icon" type="image/png" href="~/img/logo-kamerequest.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">
            <aside class="sidebar">
                <a asp-page="/Index" class="brand">
                    <img src="~/img/logo-kamerequest.png" alt="KameRequest" />
                    <span>KameRequest</span>
                </a>
                <nav class="sidebar-nav">
                    <a asp-page="/Index">Inicio</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-page="/Usuarios/Index">Usuarios</a>
                    }
                    <a asp-page="/Solicitudes/Index">Solicitudes</a>
                    <a asp-page="/Mantenimientos/Index">Mantenimientos</a>
                    <a asp-page="/Reportes/Index">Reportes</a>
                </nav>
            </aside>
            <div class="main-area">
                <header class="topbar">
                    <div></div>
                    <div class="user-info">
                        <span class="avatar" aria-label="Avatar del usuario">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z" /></svg>
                        </span>
                        <span>@User.FindFirstValue(ClaimTypes.GivenName)</span>
                        <form method="post" asp-page="/Cuenta/CerrarSesion"><button class="btn btn-sm btn-outline-secondary">Salir</button></form>
                    </div>
                </header>
                <main class="content">@RenderBody()</main>
            </div>
        </div>
    }
    else
    {
        <main>@RenderBody()</main>
    }
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

