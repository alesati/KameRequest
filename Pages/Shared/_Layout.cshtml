@using System.Security.Claims
@{
    string ClaseActual(string ruta)
    {
        return (Context.Request.Path.Value ?? string.Empty).StartsWith(ruta, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - KameRequest</title>
    <link rel="icon" type="image/png" href="~/img/logo-kamerequest.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">
            <aside class="sidebar">
                <a asp-page="/Index" class="brand">
                    <img src="~/img/logo-kamerequest.png" alt="KameRequest" />
                    <span>KameRequest</span>
                </a>
                <nav class="sidebar-nav" aria-label="Menu principal">
    <a asp-page="/Index" class="nav-link @ClaseActual("/Index")">
        <span class="nav-icon" aria-hidden="true">⌂</span><span>Inicio</span>
    </a>
    <span class="menu-title">GESTIÓN</span>
    <a asp-page="/Solicitudes/Index" class="nav-link @ClaseActual("/Solicitudes")">
        <span class="nav-icon" aria-hidden="true">▤</span><span>Solicitudes</span><span class="nav-arrow" aria-hidden="true">›</span>
    </a>
    <span class="menu-title">MANTENIMIENTOS</span>
    <a asp-page="/Mantenimientos/Index" class="nav-link @ClaseActual("/Mantenimientos")">
        <span class="nav-icon" aria-hidden="true">⚙</span><span>Mantenimientos</span><span class="nav-arrow" aria-hidden="true">›</span>
    </a>
    <span class="menu-title">REPORTES</span>
    <a asp-page="/Reportes/Index" class="nav-link @ClaseActual("/Reportes")">
        <span class="nav-icon" aria-hidden="true">▥</span><span>Reportes</span><span class="nav-arrow" aria-hidden="true">›</span>
    </a>
                </nav>
            </aside>
            <div class="main-area">
                <header class="topbar">
                    <div></div>
                    <div class="user-info">
                        <span class="avatar" aria-label="Avatar del usuario">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z" /></svg>
                        </span>
                        <span>@User.FindFirstValue(ClaimTypes.GivenName)</span>
                        <form method="post" asp-page="/Cuenta/CerrarSesion"><button class="btn btn-sm btn-outline-secondary">Salir</button></form>
                    </div>
                </header>
                <main class="content">@RenderBody()</main>
            </div>
        </div>
    }
    else
    {
        <main>@RenderBody()</main>
    }
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

