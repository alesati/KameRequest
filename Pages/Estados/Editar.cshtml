@page "{id:int}"
@model KameRequest.Pages.Estados.EditarModel
@{
    ViewData["Title"] = "Editar Estado";
}

<div class="container py-4">
    <h1>Editar estado</h1>

    <form method="post" class="card card-body">
        <input asp-for="Estado.idEstado" type="hidden" />

        <div class="mb-3">
            <label asp-for="Estado.Nombre" class="form-label">Nombre</label>
            @if (Model.Estado.idEstado == 1)
            {
                <input asp-for="Estado.Nombre" class="form-control" readonly />
                <small class="text-muted">Este es el estado inicial de las solicitudes y no se puede cambiar.</small>
            }
            else
            {
                <input asp-for="Estado.Nombre" class="form-control" />
            }
        </div>


        <div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Regresar al listado</a>
        </div>
    </form>
</div>
