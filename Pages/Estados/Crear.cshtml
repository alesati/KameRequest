@page
@model KameRequest.Pages.Estados.CrearModel
@{
    ViewData["Title"] = "Nuevo estado";
}

<div class="container py-4">
    <h1>Nuevo Estado</h1>

    <form method="post" class="card card-body">
        <div class="mb-3">
            <label asp-for="Estado.Nombre" class="form-label">Nombre</label>
            <input asp-for="Estado.Nombre" class="form-control" />
        </div>


        <div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Regresar al listado</a>
        </div>
    </form>
</div>
