<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>
  <ItemGroup>
    <!-- Los modelos y repositorios se compilan en sus propios proyectos. -->
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="KameRequest.Entities\**\*.cs" />
    <Compile Remove="KameRequest.Repository\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="KameRequest.Entities\KameRequest.Entities.csproj" />
    <ProjectReference Include="KameRequest.Repository\KameRequest.Repository.csproj" />
  </ItemGroup>
</Project>
